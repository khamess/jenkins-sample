# Copie ce fichier en .env puis ajuste.

# --- Mode ---------------------------------------------------------------
# paper = argent fictif (par défaut) · live = argent réel
MODE=paper
# SIM=1 : données simulées, pour voir le bot tourner sans réseau
SIM=0
PAPER_START_USD=100
PAPER_SLIPPAGE_PCT=1.5

# --- Réseau ---------------------------------------------------------------
# Le RPC public est limité : prends un RPC gratuit (Helius, QuickNode, Triton…) pour le live.
RPC_URL=https://api.mainnet-beta.solana.com
JUP_API_URL=https://lite-api.jup.ag/swap/v1
JUP_API_KEY=

# --- Tableau de bord ------------------------------------------------------
HOST=127.0.0.1
PORT=8787
# Obligatoire si HOST=0.0.0.0 (accès depuis ton téléphone sur le Wi-Fi)
DASHBOARD_TOKEN=

# --- SCOUT ----------------------------------------------------------------
SCOUT_INTERVAL_SEC=20
MIN_AGE_MIN=20
MAX_AGE_HOURS=48
MIN_MCAP=250000
MAX_MCAP=15000000

# --- FILTER (8 règles, un échec = éliminé) ---------------------------------
MIN_LIQUIDITY_USD=45000
MIN_VOLUME_1H_USD=60000
MAX_PUMP_1H_PCT=75
MIN_LP_LOCKED_PCT=95
MAX_TOP10_PCT=20
MAX_DEV_PCT=2
MAX_INSIDER_PCT=8
FILTER_STRICT=1

# --- ANALYST --------------------------------------------------------------
MIN_SCORE=70

# --- EXECUTOR -------------------------------------------------------------
MAX_POSITION_PCT=8
MAX_OPEN_POSITIONS=3
MIN_POSITION_USD=2
SLIPPAGE_BPS=300
MAX_PRIORITY_LAMPORTS=2000000
SOL_RESERVE=0.05

# --- RISK -----------------------------------------------------------------
RISK_POLL_SEC=8
STOP_LOSS_PCT=6
TRAIL_ACTIVATE_PCT=12
TRAIL_PCT=6
TAKE_PROFIT_PCT=0
MAX_HOLD_MIN=240
DAILY_MAX_LOSS_PCT=20
COOLDOWN_MIN=0

# --- LIVE uniquement ------------------------------------------------------
# Utilise un portefeuille DÉDIÉ avec seulement ce que tu acceptes de perdre.
# LIVE_CONFIRM=JE_COMPRENDS_LES_RISQUES
# PRIVATE_KEY=            (base58 ou tableau JSON)
# KEYPAIR_PATH=           (fichier JSON style solana-keygen)
