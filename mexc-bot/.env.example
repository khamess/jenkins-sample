# Copie ce fichier en ".env" (même dossier) puis remplis-le.

# ---------- Mode ----------
# paper = argent fictif avec les vrais prix MEXC (par défaut) · live = argent réel
MODE=paper
PAPER_START_USDT=1000

# ---------- Clé API MEXC (nécessaire pour test-api et live) ----------
# Crée-la sur MEXC > Profil > Gestion API : coche UNIQUEMENT "Futures / Trade" (jamais retrait)
# et limite-la à l'adresse IP de ton PC.
MEXC_API_KEY=
MEXC_API_SECRET=
# Obligatoire pour MODE=live :
# LIVE_CONFIRM=JE_COMPRENDS_LES_RISQUES

# ---------- Liste du matin ----------
MORNING_TIME=08:00
MIN_TURNOVER_USDT=8000000
UNIVERSE_SIZE=60
LIST_SIZE=5
MIN_SCORE=65
MIN_ATR_PCT=2
MAX_ATR_PCT=9
EXCLUDE=USDC_USDT,FDUSD_USDT,TUSD_USDT,USDE_USDT,DAI_USDT,PAXG_USDT,XAUT_USDT

# ---------- Exécution (profil moyen x5) ----------
AUTO_TRADE=true
LEVERAGE=5
MARGIN_PCT=5
MAX_POSITIONS=5
MAX_PER_SIDE=3
ENTRY_WINDOW_HOURS=8
MAX_CHASE_PCT=3
POLL_SEC=15

# ---------- Risque ----------
STOP_LOSS_PCT=2.5
TRAIL_ACTIVATE_PCT=4
TRAIL_PCT=2
TAKE_PROFIT_PCT=0
MAX_HOLD_HOURS=24
CLOSE_ON_NEW_LIST=true
DAILY_MAX_LOSS_PCT=6

# ---------- Tableau de bord ----------
HOST=127.0.0.1
PORT=8790
DASHBOARD_TOKEN=
