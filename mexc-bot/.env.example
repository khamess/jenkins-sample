# Copie ce fichier en ".env" (même dossier) puis remplis-le.

# ---------- Mode ----------
# paper = argent fictif avec les vrais prix MEXC (par défaut) · live = argent réel
MODE=paper
PAPER_START_USDT=1000

# ---------- Clé API MEXC (nécessaire pour test-api et live) ----------
# Crée-la sur MEXC > Profil > Gestion API : coche UNIQUEMENT "Futures / Trade" (jamais retrait)
# et limite-la à l'adresse IP de ton PC.
MEXC_API_KEY=
MEXC_API_SECRET=
# Obligatoire pour MODE=live :
# LIVE_CONFIRM=JE_COMPRENDS_LES_RISQUES

# ---------- Liste du matin ----------
MORNING_TIME=08:00
MIN_TURNOVER_USDT=8000000
UNIVERSE_SIZE=60
LIST_SIZE=5
MIN_SCORE=65
MIN_ATR_PCT=2
MAX_ATR_PCT=9
# Ne trader que dans le sens du BTC (BTC au-dessus / en dessous de sa moyenne 50 jours)
BTC_REGIME=true
# Somme des corrélations au BTC autorisée par côté (~3 positions très corrélées)
CORR_BUDGET=2.4
EXCLUDE=USDC_USDT,FDUSD_USDT,TUSD_USDT,USDE_USDT,DAI_USDT,PAXG_USDT,XAUT_USDT

# Filtres "qualité" : désactivés, le backtest montre qu'ils n'apportent rien de fiable
REQUIRE_ALIGN=false
MIN_RR1=0
MAX_EXT_ATR=99
RANGE_EDGE=0
MAX_STOP_PCT=99

# ---------- Exécution ----------
AUTO_TRADE=true
# Levier maximum ; la taille réelle vient du risque par trade
LEVERAGE=5
# Perte si le stop est touché, en % du capital
RISK_PER_TRADE_PCT=0.75
MAX_MARGIN_PCT=10
MAX_POSITIONS=5
MAX_PER_SIDE=3
ENTRY_WINDOW_HOURS=8
MAX_CHASE_PCT=3
POLL_SEC=15

# ---------- Risque (réglages validés par backtest) ----------
# Stop = STOP_ATR × ATR journalier (≈ 7 % pour XRP, 11 % pour ONDO)
STOP_ATR=1.5
# Trailing activé à +1,5 R, puis suit le meilleur prix à 1 R (R = distance du stop)
TRAIL_ACTIVATE_R=1.5
TRAIL_R=1
# Détention maximale : 5 jours
MAX_HOLD_HOURS=120
CLOSE_ON_NEW_LIST=false
DAILY_MAX_LOSS_PCT=4

# ---------- Tableau de bord ----------
HOST=127.0.0.1
PORT=8790
DASHBOARD_TOKEN=
