{
  "name": "futures-bot",
  "version": "1.0.0",
  "description": "Bot Futures autonome (OKX X-Perps ou MEXC) : liste long/short chaque matin, exécution, gestion du risque et backtest.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "paper": "node src/index.js --mode=paper",
    "live": "node src/index.js --mode=live",
    "liste": "node src/index.js --scan-only",
    "test-api": "node src/index.js --test-api",
    "backtest": "node src/backtest.js",
    "backtest-robustesse": "node src/backtest.js --set=robust"
  }
}
