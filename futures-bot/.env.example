# Copie ce fichier en ".env" (même dossier) puis remplis-le.

# ---------- Plateforme ----------
# okx  = OKX X-Perps (agréé MiCA + MiFID II, accessible aux comptes EEE)  ← par défaut
# mexc = MEXC (quitte la France fin 2026)
EXCHANGE=okx

# ---------- Mode ----------
# paper = argent fictif avec les vrais prix (par défaut) · live = argent réel
MODE=paper
PAPER_START_USDT=1000

# ---------- Clé API OKX (nécessaire pour test-api et live) ----------
# OKX > Profil > API > Créer une clé : permissions "Lecture" + "Trading" UNIQUEMENT (jamais "Retrait"),
# et lie-la à l'adresse IP de ton PC. Note la passphrase choisie à la création.
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
# Comptes EEE : eea.okx.com (une clé créée sur my.okx.com ne marche que là)
OKX_BASE_URL=https://eea.okx.com
# true = compte DÉMO OKX (trading simulé avec la vraie API ; crée la clé dans le mode démo d'OKX)
OKX_DEMO=false

# ---------- Clé API MEXC (seulement si EXCHANGE=mexc) ----------
MEXC_API_KEY=
MEXC_API_SECRET=

# Obligatoire pour MODE=live :
# LIVE_CONFIRM=JE_COMPRENDS_LES_RISQUES

# ---------- Liste du matin ----------
MORNING_TIME=08:00
# Volume 24 h minimum en dollars (0 = défaut de la plateforme : OKX 500 000, MEXC 8 000 000)
MIN_TURNOVER_USDT=0
UNIVERSE_SIZE=60
LIST_SIZE=5
MIN_SCORE=65
MIN_ATR_PCT=2
MAX_ATR_PCT=9
# Ne trader que dans le sens du BTC (BTC au-dessus / en dessous de sa moyenne 50 jours)
BTC_REGIME=true
# Somme des corrélations au BTC autorisée par côté (~3 positions très corrélées)
CORR_BUDGET=2.4
# Cryptos à ne jamais trader (noms courts)
EXCLUDE=USDC,FDUSD,TUSD,USDE,DAI,PAXG,XAUT

# Filtres "qualité" : désactivés, le backtest montre qu'ils n'apportent rien de fiable
REQUIRE_ALIGN=false
MIN_RR1=0
MAX_EXT_ATR=99
RANGE_EDGE=0
MAX_STOP_PCT=99

# ---------- Exécution ----------
AUTO_TRADE=true
# Levier maximum (10 au plus) ; la taille réelle vient du risque par trade
LEVERAGE=5
# Perte si le stop est touché, en % du capital
RISK_PER_TRADE_PCT=0.75
MAX_MARGIN_PCT=10
MAX_POSITIONS=5
MAX_PER_SIDE=3
ENTRY_WINDOW_HOURS=8
MAX_CHASE_PCT=3
POLL_SEC=15

# ---------- Risque (réglages validés par backtest) ----------
# Stop = STOP_ATR × ATR journalier (≈ 7 % pour XRP, 11 % pour ONDO)
STOP_ATR=1.5
# Trailing activé à +1,5 R, puis suit le meilleur prix à 1 R (R = distance du stop)
TRAIL_ACTIVATE_R=1.5
TRAIL_R=1
# Détention maximale : 5 jours
MAX_HOLD_HOURS=120
CLOSE_ON_NEW_LIST=false
DAILY_MAX_LOSS_PCT=4

# ---------- Tableau de bord ----------
HOST=127.0.0.1
PORT=8790
DASHBOARD_TOKEN=
